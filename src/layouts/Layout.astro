---
const { title = "Student Organization" } = Astro.props;
import "../styles/layout.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <div><strong>Student Org</strong></div>

      <nav>
        <a href="/">Home</a>
        <a href="/documents">Documents</a>
        <a href="/about">About</a>
        <a href="/events">Events</a>
      </nav>
    </header>

    <main>
      <!-- Page content gets injected here -->
      <slot />
    </main>

    <footer>
      <p>contact@example.com</p>
      <p>© 2026 Student Organization</p>
    </footer>
  </body>
</html>