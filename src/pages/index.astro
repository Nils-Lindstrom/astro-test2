---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const events = [
  {
    title: "Board Game Night",
    date: "2026-09-12",
    location: "Student Union",
  },
  {
    title: "OP Kickoff",
    date: "2026-08-20",
    location: "Main Hall",
  },
];
---

<Layout title="Home">

  <!-- HERO -->
  <section>
    <h1>Welcome to the Student Organization</h1>
    <p>
      We organize events, introduction weeks, and community activities for students.
    </p>
  </section>

  <hr />

  <!-- EVENTS -->
  <section>
    <h2>Upcoming Events</h2>

    {events.map((event) => (
      <div style="margin-bottom: 1rem; padding: 1rem; background: #1e293b; border-radius: 10px;">
        <h3>{event.title}</h3>
        <p>Date: {event.date}</p>
        <p>Location: {event.location}</p>
      </div>
    ))}
  </section>

  <hr />

  <!-- QUICK LINKS -->
  <section>
    <h2>Quick Links</h2>

    <ul>
      <li><a href="/op">OP Information</a></li>
      <li><a href="/documents">Public Documents</a></li>
      <li><a href="/about">Board Members</a></li>
    </ul>
  </section>

</Layout>